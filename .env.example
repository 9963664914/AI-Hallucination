SECRET_KEY=django-insecure-hallucibench-prod-secret-key-change-me-in-production!
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (Defaults to SQLite for local dev if DB_HOST is not set)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Celery & Redis Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_ALWAYS_EAGER=True

# External API keys (Optional - fallback to Mock Provider if not supplied)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
